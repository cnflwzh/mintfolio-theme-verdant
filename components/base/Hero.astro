---
/**
 * Hero - Full-screen hero section component for the home page.
 * 
 * Displays the main profile introduction with:
 * - Avatar image from the public profile
 * - Name with gradient text styling
 * - Bio and location information
 * - Social media links (GitHub, Twitter, Email with icon support)
 */
import type { ThemeContext } from '@mintfolio/theme-api';
import type { DefaultSettings } from '../../settings';

/** Public site data supplied by the containing theme page. */
interface Props { theme: ThemeContext<DefaultSettings>; }
import Image from '@mintfolio/core/components/Image.astro';

const { theme } = Astro.props;
const { profile, social } = theme.site;
const profileAvatar = profile.avatar;
---

<section id="hero" class="section-bg">
  <div class="hero-container">
    <div class="hero-content">
      <Image
        src={profileAvatar}
        alt={`${profile.name}'s avatar`}
        class="avatar"
        width={150}
        height={150}
      />
      
      <h1 class="name gradient-text">{profile.name}</h1>
      
      <p class="bio">{profile.bio}</p>
      
      <div class="location">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="location-icon"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{profile.location}</span>
      </div>
      
      <nav class="social-links" aria-label="Social media links">
        {social.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label={link.platform}
          >
            {link.icon === 'github' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            )}
            {link.icon === 'mail' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            )}
            {link.icon === 'twitter' && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            )}
            {!['github', 'mail', 'twitter'].includes(link.icon) && (
              <span class="fallback-icon">{link.platform.charAt(0).toUpperCase()}</span>
            )}
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>

<style>
  section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }

  .hero-container {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .avatar {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--glass-border);
    box-shadow: var(--glow-primary);
  }

  .name {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .bio {
    font-size: clamp(1rem, 3vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.6;
    margin: 0;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .location-icon {
    opacity: 0.7;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--color-surface);
    border: 1px solid var(--glass-border);
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .social-link svg {
    width: 22px;
    height: 22px;
  }

  .fallback-icon {
    font-size: 1.25rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    section {
      padding: 3rem 1rem;
    }

    .avatar {
      width: 120px;
      height: 120px;
    }

    .social-links {
      gap: 0.75rem;
    }

    .social-link {
      width: 44px;
      height: 44px;
    }
  }
</style>
