---
/**
 * ArticleProse - Blog article content wrapper component.
 *
 * Provides styled prose container for Markdown-rendered blog content with:
 * - Typography styles for headings, paragraphs, lists, code blocks
 * - Styles Core-rendered, keyboard-accessible table scroll regions without JavaScript
 * - Responsive padding adjustments for mobile devices
 */
---

<div class="post-content article-prose">
  <slot />
</div>

<style>
  .post-content.article-prose {
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 4.5vw, 3rem);
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--color-text);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .post-content.article-prose > :global(:first-child) {
    margin-top: 0;
  }

  .post-content.article-prose :global(h1),
  .post-content.article-prose :global(h2),
  .post-content.article-prose :global(h3),
  .post-content.article-prose :global(h4),
  .post-content.article-prose :global(h5),
  .post-content.article-prose :global(h6) {
    color: var(--color-text-headline);
    margin-top: 2rem;
    margin-bottom: 0.8rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
    scroll-margin-top: 2rem;
    text-wrap: balance;
  }

  .post-content.article-prose :global(h1) {
    font-size: 1.85rem;
  }

  .post-content.article-prose :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.5rem;
  }

  /* A short highlighter bar marks each major section. */
  .post-content.article-prose :global(h2::before) {
    content: '';
    display: block;
    width: 2rem;
    height: 4px;
    margin-bottom: 0.8rem;
    border-radius: 999px;
    background: var(--color-play);
  }

  .post-content.article-prose :global(h3) {
    font-size: 1.22rem;
  }

  .post-content.article-prose :global(h4) {
    font-size: 1.05rem;
  }

  .post-content.article-prose :global(p) {
    margin-bottom: 1.15em;
  }

  .post-content.article-prose :global(strong) {
    color: var(--color-text-headline);
    font-weight: 700;
  }

  .post-content.article-prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color var(--transition-fast);
  }

  .post-content.article-prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .post-content.article-prose :global(ul),
  .post-content.article-prose :global(ol) {
    margin-bottom: 1.15em;
    padding-left: 1.4rem;
  }

  .post-content.article-prose :global(ul) {
    list-style: disc;
  }

  .post-content.article-prose :global(ol) {
    list-style: decimal;
  }

  .post-content.article-prose :global(li) {
    margin-bottom: 0.4rem;
    padding-left: 0.2rem;
  }

  .post-content.article-prose :global(li::marker) {
    color: var(--color-primary);
    font-weight: 600;
  }

  .post-content.article-prose :global(li > ul),
  .post-content.article-prose :global(li > ol) {
    margin: 0.4rem 0 0;
  }

  .post-content.article-prose :global(:not(pre) > code),
  .post-content.article-prose :global(li > code),
  .post-content.article-prose :global(p > code),
  .post-content.article-prose :global(td > code) {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    font-size: 0.86em;
    font-family: var(--font-mono);
    border: 1px solid color-mix(in srgb, var(--color-primary) 16%, transparent);
  }

  .post-content.article-prose :global(pre:not([data-code-block-enhanced='1'])) {
    position: relative;
    background: linear-gradient(180deg, rgba(14, 20, 27, 0.96) 0%, rgba(24, 32, 43, 0.98) 100%);
    color: #edf2f7;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: var(--radius-md);
    padding: 1.1rem 1rem 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
  }

  .post-content.article-prose :global(pre:not([data-code-block-enhanced='1']) code) {
    background: none;
    padding: 0;
    color: inherit;
    border: none;
    display: block;
    font-size: 0.88rem;
    line-height: 1.7;
    white-space: pre;
  }

  .post-content.article-prose :global(.code-block-shell pre) {
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    overflow: auto;
  }

  .post-content.article-prose :global(pre:not([data-code-block-enhanced='1']) code:not([class])),
  .post-content.article-prose :global(pre:not([data-code-block-enhanced='1']) code.language-text),
  .post-content.article-prose :global(pre:not([data-code-block-enhanced='1']) code[class*='language-text']) {
    color: #f8fafc;
  }

  .post-content.article-prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.95rem 1.25rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: color-mix(in srgb, var(--color-accent-soft) 40%, transparent);
    color: var(--color-text-muted);
  }

  .post-content.article-prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .post-content.article-prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .post-content.article-prose :global(hr) {
    height: 0;
    margin: 2.75rem auto;
    border: none;
    border-top: 1px dashed var(--color-border);
  }

  .post-content.article-prose :global(.table-scroll-wrap),
  .post-content.article-prose :global([data-mintfolio-table-scroll]) {
    margin: 1.75rem 0;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    -webkit-overflow-scrolling: touch;
  }

  .post-content.article-prose :global(table) {
    width: 100%;
    min-width: 32rem;
    border-collapse: separate;
    border-spacing: 0;
    margin: 0;
    background: transparent;
    font-size: 0.94rem;
  }

  .post-content.article-prose :global(thead) {
    background: var(--color-tag-bg);
  }

  .post-content.article-prose :global(th),
  .post-content.article-prose :global(td) {
    padding: 0.65rem 1rem;
    text-align: left;
    vertical-align: top;
    /* Break long identifiers only when they cannot fit, never mid-word by default. */
    overflow-wrap: break-word;
    /* Columns beside an unbreakable identifier must not collapse to one character. */
    min-width: 6em;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .post-content.article-prose :global(th) {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--color-text-headline);
    white-space: nowrap;
  }

  .post-content.article-prose :global(td) {
    line-height: 1.65;
  }

  .post-content.article-prose :global(tbody tr:nth-child(even) td) {
    background: color-mix(in srgb, var(--color-bg-alt) 60%, transparent);
  }

  .post-content.article-prose :global(tr:last-child td) {
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .post-content.article-prose {
      font-size: 1rem;
      line-height: 1.85;
    }

    .post-content.article-prose :global(h2) {
      font-size: 1.32rem;
    }

    .post-content.article-prose :global(h3) {
      font-size: 1.12rem;
    }

    .post-content.article-prose :global(table) {
      min-width: 28rem;
      font-size: 0.9rem;
    }

    .post-content.article-prose :global(th),
    .post-content.article-prose :global(td) {
      padding: 0.6rem 0.8rem;
    }
  }
</style>
