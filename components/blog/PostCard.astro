---
import Image from '@mintfolio/core/components/Image.astro';
import type { PostSummary } from '@mintfolio/theme-api';
import { createSearchEntry } from '@mintfolio/theme-api/search';
import { formatSiteDate } from '../../utils/dates';

interface Props {
  /** Core-projected metadata; includes no password or protected plaintext. */
  post: PostSummary;
  index: number;
  pageSize: number;
  variant: 'home' | 'blog';
  language: string;
  timezone?: string;
}

const { post, index, pageSize, variant, language, timezone } = Astro.props;
const Heading = variant === 'home' ? 'h3' : 'h2';
const search = createSearchEntry(post);
const publishedAt = formatSiteDate(post.publishedAt, language, timezone);
---

<article
  class:list={['post-card', { 'home-card': variant === 'home', 'has-cover': post.cover, 'initially-hidden': index >= pageSize }]}
  data-id={post.id}
  data-url={post.url}
  data-title={search.title}
  data-description={search.description}
  data-tags={JSON.stringify(search.tags)}
  data-category={search.category}
>
  <a href={post.url} data-article-link class="post-link" draggable="false">
    {post.cover && (
      <div class="post-cover">
        <Image src={post.cover} alt="" loading="lazy" width={800} height={450} draggable="false"
          layout="constrained" widths={[400, 800]} sizes="(max-width: 600px) calc(100vw - 5rem), (max-width: 900px) 29vw, 340px" />
      </div>
    )}
    <div class="post-content">
      <div class="post-meta">
        <span class="post-category">{post.category.label}</span>
        <time class="post-date" datetime={post.publishedAt}>{publishedAt}</time>
      </div>
      <Heading class="post-title">{post.protected && <span class="post-lock" role="img" aria-label="加密文章"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>}{post.title}</Heading>
      <p class="post-description">{post.description}</p>
      {post.tags?.length ? (
        <div class="post-tags">{post.tags.map((tag) => <span class="tag">{tag.label}</span>)}</div>
      ) : null}
    </div>
    <span class="post-arrow" aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    --card-color: var(--color-primary);
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    overflow: hidden;
  }
  .post-card:nth-child(3n + 2) { --card-color: var(--color-accent); }
  .post-card:nth-child(3n + 3) { --card-color: var(--color-play); }
  .post-card::before { content: ''; position: absolute; left: 0; top: 1.6rem; bottom: 1.6rem; width: 4px; background: var(--card-color); border-radius: 0 4px 4px 0; transition: top var(--transition-base), bottom var(--transition-base); }
  .post-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border)); box-shadow: 6px 6px 0 color-mix(in srgb, var(--card-color) 24%, var(--color-bg)); }
  .post-card:hover::before { top: 0; bottom: 0; }
  .post-card:focus-within { border-color: var(--color-primary); }
  .post-card.initially-hidden, .post-card.hidden { display: none; }
  .post-link { display: flex; align-items: center; gap: 1.5rem; padding: 1.6rem 1.75rem 1.6rem 2rem; text-decoration: none; }
  .post-link:focus-visible { outline-offset: -4px; border-radius: inherit; }
  .post-content { flex: 1; min-width: 0; order: 0; }
  .post-meta { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-bottom: .75rem; }
  .post-category { color: var(--color-primary); background: var(--color-tag-bg); padding: .2rem .65rem; border-radius: 999px; font-size: .74rem; font-weight: 650; }
  .post-date { font: .76rem var(--font-mono); color: var(--color-text-muted); }
  .post-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -.02em; color: var(--color-text-headline); margin-bottom: .55rem; line-height: 1.45; text-wrap: balance; word-break: keep-all; overflow-wrap: anywhere; transition: color var(--transition-fast); }
  .post-card:hover .post-title { color: var(--color-primary); }
  .post-lock { display: inline-grid; place-items: center; width: 1.6em; height: 1.6em; margin-right: .45rem; border-radius: 8px; background: var(--color-accent-soft); color: var(--color-accent); vertical-align: -.3em; }
  .post-lock svg { width: .9em; height: .9em; }
  .post-description { font-size: .93rem; color: var(--color-text-muted); line-height: 1.75; margin-bottom: .95rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-tags { display: flex; flex-wrap: wrap; gap: .3rem .9rem; }
  .tag { padding: 0; background: none; border-radius: 0; color: var(--color-text-muted); font-size: .78rem; font-weight: 500; }
  .tag::before { content: '#'; color: var(--color-primary); margin-right: .15rem; }
  .post-cover { order: 2; flex: 0 0 29%; width: 29%; aspect-ratio: 16 / 10; border-radius: var(--radius-md); overflow: hidden; background: var(--color-bg-alt); }
  .post-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .post-card:hover .post-cover img { transform: scale(1.04); }
  .post-arrow { flex: 0 0 38px; order: 1; width: 38px; height: 38px; border: 1px solid var(--color-border); border-radius: 50%; color: var(--color-primary); display: grid; place-items: center; font-size: 1.05rem; transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast); }
  .post-card:hover .post-arrow { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); transform: translateX(3px); }
  .post-card.has-cover .post-arrow { display: none; }
  @media (max-width: 600px) {
    .post-link { flex-wrap: wrap; padding: 1.1rem 1.1rem 1.1rem 1.35rem; gap: 1rem; }
    .post-cover { flex: 0 0 100%; width: 100%; order: -1; }
    .post-content { flex: 1 1 0; }
    .post-title { font-size: 1.1rem; }
    .post-description { font-size: .88rem; }
    .post-arrow { display: none; }
    .post-meta { gap: .55rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card, .post-cover img, .post-arrow, .post-card::before { transition: none; }
    .post-card:hover, .post-card:hover .post-cover img, .post-card:hover .post-arrow { transform: none; }
  }
</style>
