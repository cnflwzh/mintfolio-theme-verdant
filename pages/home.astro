---
/** Verdant home renderer consumes only public site, post, and taxonomy data. */
import PostCard from '../components/blog/PostCard.astro';
import SocialIcon from '../components/base/SocialIcon.astro';
import Base from '../layouts/Base.astro';
import { formatSiteDate } from '../utils/dates';
import { resolveThemeUrl } from '../utils/themeUrls';
import Image from '@mintfolio/core/components/Image.astro';
import type { PageProps, HomePageData } from '@mintfolio/theme-api/astro';
import type { VerdantSettings } from '../settings';

interface Props extends PageProps<VerdantSettings, HomePageData> {}
const { theme, page } = Astro.props;
const posts = page.posts;
const HOME_PAGE_SIZE = theme.settings.homePageSize;
const latestActivityPosts = posts.slice(0, 3);
const projectCount = theme.site.projects.length;
const latestPost = posts[0] ?? null;
const profileAvatar = theme.site.profile.avatar;
const [allTags, allCategories] = await Promise.all([theme.taxonomy.tags(), theme.taxonomy.categories()]);
// Empty counts read as unfinished, so the hero only lists what the site actually has.
const heroStats = [
  { label: '篇文章', value: posts.length },
  { label: '个项目', value: projectCount },
  { label: '个专题', value: allCategories.length },
].filter((stat) => stat.value > 0);
const hotContentPosts = theme.settings.home.hotContent.items
  .map((item) => {
    const post = posts.find((entry) => entry.id === item.postId);
    return post ? { post, image: resolveThemeUrl(item.image) } : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
  .slice(0, 3);
---

<Base theme={theme} page={page}>
  <!-- Hero Section -->
  <section class="hero" id="hero" aria-label="欢迎区域">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
    </div>
    <div class="hero-content">
      <div class="hero-shell">
        <div class="hero-copy">
          {theme.site.description && <p class="hero-kicker">{theme.site.description}</p>}
          <h1 class="hero-name">{theme.site.profile.name}</h1>
          <p class="hero-tagline">{theme.site.profile.bio}</p>
          {theme.site.profile.signature && <p class="hero-signature">{theme.site.profile.signature}</p>}

          {(theme.site.profile.location || latestPost) && (
            <ul class="hero-meta">
              {theme.site.profile.location && (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  <span>{theme.site.profile.location}</span>
                </li>
              )}
              {latestPost && (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9"/>
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                  </svg>
                  <span>最近更新 <time datetime={latestPost.publishedAt}>{formatSiteDate(latestPost.publishedAt, theme.site.language, theme.site.blog?.timezone)}</time></span>
                </li>
              )}
            </ul>
          )}

          <div class="hero-actions">
            <a href="#content" class="hero-btn primary">
              <span>浏览文章</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/>
                <path d="m13 6 6 6-6 6"/>
              </svg>
            </a>
            <a href={theme.urls.page('about')} class="hero-btn secondary">关于我</a>
            {theme.site.social.length > 0 && (
              <nav class="hero-social" aria-label="社交链接">
                {theme.site.social.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="hero-social-link" aria-label={link.platform} title={link.platform}>
                    <SocialIcon icon={link.icon} platform={link.platform} />
                  </a>
                ))}
              </nav>
            )}
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-orbit" aria-hidden="true"><span class="orbit-dot"></span></div>
          <div class="hero-blob" aria-hidden="true"></div>
          <div class="hero-avatar-frame">
            <Image src={profileAvatar} alt={theme.site.profile.name} class="hero-avatar" width={340} height={340} />
          </div>
          <span class="hero-sticker" aria-hidden="true">保持好奇 ✳</span>
          {heroStats.length > 0 && (
            <dl class="hero-stats" aria-label="站点概览">
              {heroStats.map((stat) => (
                <div class="hero-stat">
                  <dt>{stat.label}</dt>
                  <dd data-countup={stat.value}>{stat.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </div>

    <div class="scroll-indicator" role="button" tabindex="0" aria-label="向下滚动查看内容">
      <span class="scroll-mouse" aria-hidden="true">
        <span class="scroll-dot"></span>
      </span>
      <span class="scroll-text">向下滚动</span>
    </div>
  </section>

  <!-- Main Content -->
  <section class="content-wrapper" id="content">
    <button class="sidebar-drawer-toggle" id="sidebar-drawer-toggle" aria-label="打开侧边栏" aria-expanded="false">
      <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"/>
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

    <div class="content-grid">
      <!-- Left Sidebar -->
      <aside class="sidebar sidebar-drawer" id="sidebar">
        <div class="sidebar-card">
          <div class="sidebar-header">
            <div class="sidebar-avatar">
              <Image src={profileAvatar} alt={theme.site.profile.name} width={80} height={80} />
            </div>
            <h2 class="sidebar-name">{theme.site.profile.name}</h2>
            <p class="sidebar-bio">{theme.site.profile.bio}</p>
          </div>

          {theme.settings.sidebar.sections.contact && (
            <div class="sidebar-section">
              <h3 class="sidebar-section-title">联系方式</h3>
              <div class="social-links">
                {theme.site.social.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={link.platform}>
                    <SocialIcon icon={link.icon} platform={link.platform} />
                  </a>
                ))}
              </div>
            </div>
          )}

          {theme.settings.sidebar.quote.enabled && (
            <div class="sidebar-section">
              <blockquote class="quote">
                <p class="quote-text">"{theme.settings.sidebar.quote.text}"</p>
                <cite class="quote-author">— {theme.settings.sidebar.quote.author}</cite>
              </blockquote>
            </div>
          )}

          {theme.settings.sidebar.sections.activity && (
            <div class="sidebar-section">
              <h3 class="sidebar-section-title">最近动态</h3>
              <div class="activity-list">
                {latestActivityPosts.map((post) => (
                  <div class="activity-item">
                    <span class="activity-dot"></span>
                    <div class="activity-content">
                      <p class="activity-text">
                        <a class="activity-link" href={post.url} data-article-link>{post.title}</a>
                      </p>
                      <time class="activity-time" datetime={post.publishedAt}>{formatSiteDate(post.publishedAt, theme.site.language, theme.site.blog?.timezone)}</time>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {theme.settings.sidebar.sections.tools && (
            <div class="sidebar-section">
              <h3 class="sidebar-section-title">推荐工具</h3>
              <div class="tools-list">
                {theme.settings.sidebar.tools.map((tool) => (
                  <a href={resolveThemeUrl(tool.url)} target="_blank" rel="noopener noreferrer" class="tool-item">
                    <span class="tool-name">{tool.name}</span>
                    <span class="tool-desc">{tool.description}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>

      <!-- Right: Blog Section -->
      <main class="blog-section">
        <button class="search-float-btn" id="search-float-btn" aria-label="打开搜索">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
        </button>

        <dialog class="search-modal" id="search-modal" aria-label="文章搜索">
          <div class="search-modal-panel">
            <div class="search-modal-header">
              <h3>文章筛选</h3>
              <button class="search-close-btn" id="search-close-btn" aria-label="关闭搜索">×</button>
            </div>
            <div class="search-wrapper search-modal-input-wrap">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <path d="M21 21l-4.35-4.35"/>
              </svg>
              <input type="text" id="search-modal-input" class="search-input" placeholder="输入关键字搜索文章..." aria-label="搜索文章" />
            </div>

            <div class="search-filter-group">
              <p class="search-filter-label" id="category-filter-label">分类</p>
              <div class="category-filter" id="category-filter" role="radiogroup" aria-labelledby="category-filter-label">
                <button class="category-btn active" role="radio" aria-checked="true" data-category="">全部分类</button>
                {allCategories.map((category) => (
                  <button class="category-btn" role="radio" aria-checked="false" data-category={category.label}>{category.label}</button>
                ))}
              </div>
            </div>

            <div class="search-filter-group">
              <p class="search-filter-label" id="tag-filter-label">标签</p>
              <div class="tags-filter-block" data-max-rows="4">
                <div class="tags-filter" id="tags-filter" role="radiogroup" aria-labelledby="tag-filter-label">
                  <button class="tag-btn active" role="radio" aria-checked="true" data-tag="">全部</button>
                  {allTags.map(tag => (
                    <button class="tag-btn" role="radio" aria-checked="false" data-tag={tag.label}>{tag.label}</button>
                  ))}
                </div>
                <button class="tags-filter-toggle" id="home-tags-filter-toggle" type="button" hidden aria-expanded="false">
                  展开更多
                </button>
              </div>
            </div>

            <div class="search-actions">
              <button class="search-apply-btn" id="search-apply-btn">到博客页搜索</button>
            </div>
          </div>
        </dialog>

        <div class="blog-header">
          {theme.settings.home.hotContent.enabled && hotContentPosts.length > 0 && (
            <section class="feature-banner" aria-roledescription="carousel" aria-label="值得一读" data-feature-banner>
              <div class="banner-track">
                {hotContentPosts.map(({ post, image }, index) => (
                  <div class:list={['banner-slide', { 'is-active': index === 0 }]} role="group" aria-roledescription="slide" aria-label={`${index + 1} / ${hotContentPosts.length}`}>
                    <a href={post.url} data-article-link class="banner-link">
                      <Image src={image} alt="" loading="lazy" decoding="async" width={1200} height={514} draggable="false" />
                      <span class="banner-shade" aria-hidden="true"></span>
                      <span class="banner-copy">
                        <span class="banner-kicker">
                          <span>值得一读</span>
                          {hotContentPosts.length > 1 && <span class="banner-count">{String(index + 1).padStart(2, '0')} / {String(hotContentPosts.length).padStart(2, '0')}</span>}
                        </span>
                        <span class="banner-title">{post.title}</span>
                        {post.description && <span class="banner-desc">{post.description}</span>}
                        <span class="banner-meta">
                          <span class="banner-category">{post.category.label}</span>
                          <time datetime={post.publishedAt}>{formatSiteDate(post.publishedAt, theme.site.language, theme.site.blog?.timezone)}</time>
                        </span>
                      </span>
                    </a>
                  </div>
                ))}
              </div>
              {hotContentPosts.length > 1 && (
                <div class="banner-controls">
                  <button class="banner-arrow" type="button" data-banner-prev aria-label="上一篇推荐">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                  <div class="banner-dots">
                    {hotContentPosts.map((_, index) => (
                      <button class="banner-dot" type="button" aria-label={`第 ${index + 1} 篇推荐`} aria-current={index === 0 ? 'true' : 'false'}>
                        <span class="banner-dot-bar"><span class="banner-dot-fill"></span></span>
                      </button>
                    ))}
                  </div>
                  <button class="banner-arrow" type="button" data-banner-next aria-label="下一篇推荐">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                </div>
              )}
            </section>
          )}

          <div class="blog-title-row">
            <div><p class="section-eyebrow">THE LATEST NOTES</p><h2 class="blog-title">最近在写<span class="title-dot" aria-hidden="true">.</span></h2></div>
            <a href={theme.urls.archive()} class="view-all-link">查看全部 →</a>
          </div>

          <div class="blog-controls"></div>
        </div>

        <div id="posts-list" class="posts-list" data-page-size={HOME_PAGE_SIZE}>
          {posts.map((post, index) => (
          <PostCard post={post} index={index} pageSize={HOME_PAGE_SIZE} variant="home" language={theme.site.language} timezone={theme.site.blog?.timezone} />
        ))}
        </div>

        <p id="no-results" class="no-results" style="display: none;">
          没有找到匹配的文章
        </p>

        <div class="load-more-wrap" id="load-more-wrap">
          <button class="load-more-btn" id="load-more-btn">加载更多文章</button>
        </div>
      </main>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <p class="copyright">© {formatSiteDate(new Date(), theme.site.language, theme.site.blog?.timezone, { year: 'numeric' })} {theme.site.profile.name}. Built with Astro.</p>
      <p class="site-links">
        <a href={theme.urls.rss()} target="_blank" rel="noopener noreferrer">RSS 订阅</a>
        <span>·</span>
        <a href={theme.urls.sitemap()} target="_blank" rel="noopener noreferrer">网站树</a>
      </p>
      {theme.site.icp && (
        <p class="icp">
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{theme.site.icp}</a>
        </p>
      )}
    </div>
  </footer>
</Base>

<style>
  /* ===== HERO SECTION ===== */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: var(--color-bg);
  z-index: 100;
  transition: transform var(--transition-base), opacity var(--transition-base);
}

.hero.collapsed {
  transform: translateY(-100%);
  opacity: 0;
  pointer-events: none;
}

.hero.collapsed *,
.hero.is-paused * {
  animation-play-state: paused !important;
}

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  /* Oversized layers leave room for the pointer parallax in hero.ts. */
  .hero-gradient {
    position: absolute;
    inset: -48px;
    background:
      radial-gradient(40% 55% at 74% 45%, var(--color-play-soft), transparent 72%),
      radial-gradient(32% 42% at 6% 96%, color-mix(in srgb, var(--color-accent-soft) 70%, transparent), transparent 72%),
      radial-gradient(36% 46% at 16% 6%, color-mix(in srgb, var(--color-tag-bg) 85%, transparent), transparent 72%);
  }

  .hero-pattern {
    position: absolute;
    inset: -48px;
    background-image: radial-gradient(var(--color-border) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(ellipse 72% 62% at 50% 45%, #000 15%, transparent 78%);
    mask-image: radial-gradient(ellipse 72% 62% at 50% 45%, #000 15%, transparent 78%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(92vw, 1160px);
    padding: clamp(1rem, 3vh, 2rem) clamp(0.5rem, 2vw, 1.5rem) clamp(3rem, 8vh, 4.5rem);
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero-copy > * {
    animation: heroRise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-copy > :nth-child(2) { animation-delay: 0.06s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.12s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.18s; }
  .hero-copy > :nth-child(5) { animation-delay: 0.24s; }
  .hero-copy > :nth-child(6) { animation-delay: 0.3s; }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hero-kicker::before {
    content: '';
    flex-shrink: 0;
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .hero-name {
    position: relative;
    isolation: isolate;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1.3rem;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, min(8.4vw, 13vh), 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-primary);
    overflow-wrap: anywhere;
  }

  /* Highlighter swash drawn under the name once the copy settles in. */
  .hero-name::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -0.05em;
    right: -0.08em;
    bottom: 0.02em;
    height: 0.28em;
    border-radius: 999px;
    background: var(--color-play);
    opacity: 0.8;
    transform: rotate(-1.5deg);
    transform-origin: left center;
    animation: heroSwash 0.9s 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes heroSwash {
    from { transform: rotate(-1.5deg) scaleX(0); }
    to { transform: rotate(-1.5deg) scaleX(1); }
  }

  .hero-tagline {
    max-width: 32rem;
    margin-bottom: 0.9rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-text);
  }

  .hero-signature {
    max-width: 32rem;
    margin-bottom: 1.6rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-accent);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .hero-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-meta svg {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--color-primary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    height: 3rem;
    padding: 0 1.45rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .hero-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform var(--transition-fast);
  }

  .hero-btn.primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border: 1.5px solid var(--color-primary);
    box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--color-primary) 80%, transparent);
  }

  .hero-btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -12px color-mix(in srgb, var(--color-primary) 90%, transparent);
  }

  .hero-btn.primary:hover svg {
    transform: translateX(3px);
  }

  .hero-btn.secondary {
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    color: var(--color-text);
    border: 1.5px solid var(--color-border);
  }

  .hero-btn.secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .hero-social {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.3rem;
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }

  .hero-social-link {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    color: var(--color-text-muted);
    font-weight: 700;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero-social-link:hover {
    color: var(--color-primary);
    background: var(--color-tag-bg);
    transform: translateY(-2px);
  }

  .hero-btn:focus-visible,
  .hero-social-link:focus-visible,
  .scroll-indicator:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Avatar composition: blob and orbit sit behind, stickers float on top. */
  .hero-visual {
    --avatar-size: clamp(220px, min(26vw, 40vh), 340px);
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    width: calc(var(--avatar-size) * 1.45);
    aspect-ratio: 1;
    animation: heroPop 1s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes heroPop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-orbit {
    position: absolute;
    inset: 3%;
    border: 1.5px dashed color-mix(in srgb, var(--color-primary) 35%, transparent);
    border-radius: 50%;
    animation: heroOrbit 48s linear infinite;
  }

  .orbit-dot {
    position: absolute;
    top: 14.6%;
    left: 14.6%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 25%, transparent);
    transform: translate(-50%, -50%);
  }

  @keyframes heroOrbit {
    to { transform: rotate(360deg); }
  }

  .hero-blob {
    position: absolute;
    width: calc(var(--avatar-size) * 1.1);
    aspect-ratio: 1;
    background: var(--color-play);
    border-radius: 58% 42% 55% 45% / 46% 56% 44% 54%;
    transform: translate(7%, 6%) rotate(-8deg);
    animation: heroBlob 16s ease-in-out infinite alternate;
  }

  @keyframes heroBlob {
    50% {
      border-radius: 44% 56% 40% 60% / 58% 42% 58% 42%;
      transform: translate(5%, 8%) rotate(0deg);
    }
    100% {
      border-radius: 52% 48% 62% 38% / 40% 60% 44% 56%;
      transform: translate(8%, 5%) rotate(6deg);
    }
  }

  .hero-avatar-frame {
    position: relative;
    width: var(--avatar-size);
    aspect-ratio: 1;
    overflow: hidden;
    border: 6px solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1.5px var(--color-text),
      0 28px 50px -24px color-mix(in srgb, var(--color-text) 45%, transparent);
  }

  .hero-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-sticker {
    position: absolute;
    top: 12%;
    right: 3%;
    padding: 0.45rem 0.95rem;
    border: 1.5px solid var(--color-text);
    border-radius: 10px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 3px 3px 0 var(--color-text);
    animation: heroFloat 6s ease-in-out infinite;
  }

  @keyframes heroFloat {
    0%, 100% { transform: rotate(8deg) translateY(0); }
    50% { transform: rotate(5deg) translateY(-6px); }
  }

  .hero-stats {
    position: absolute;
    left: 0;
    bottom: 9%;
    display: flex;
    margin: 0;
    padding: 0.7rem 0.3rem;
    border: 1.5px solid var(--color-text);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: 4px 4px 0 var(--color-accent-soft);
    transform: rotate(-4deg);
  }

  .hero-stat {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    padding: 0 0.9rem;
  }

  .hero-stat + .hero-stat {
    border-left: 1px solid var(--color-border);
  }

  .hero-stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-primary);
  }

  .hero-stat dt {
    font-size: 0.72rem;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .scroll-indicator {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3.5vh, 2rem);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transform: translateX(-50%);
    transition: color var(--transition-fast);
  }

  .scroll-indicator:hover {
    color: var(--color-primary);
  }

  .scroll-mouse {
    position: relative;
    width: 22px;
    height: 34px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
  }

  .scroll-dot {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-primary);
    transform: translateX(-50%);
    animation: scrollDot 1.6s ease-in-out infinite;
  }

  @keyframes scrollDot {
    0%, 100% { top: 7px; opacity: 1; }
    50% { top: 16px; opacity: 0.3; }
  }

  .scroll-text {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
  }

  :global([data-theme^='dark']) .hero-blob {
    opacity: 0.4;
  }

  :global([data-theme^='dark']) .hero-name::after {
    opacity: 0.35;
  }

  /* Short desktop windows: drop the secondary line before shrinking further. */
  @media (min-width: 901px) and (max-height: 680px) {
    .hero-signature {
      display: none;
    }

    .hero-meta {
      margin-bottom: 1.4rem;
    }

    .hero-tagline {
      margin-bottom: 1.1rem;
    }
  }

  /* Tablet and phone: avatar on top, one centered column. */
  @media (max-width: 900px) {
    .hero-content {
      width: min(92vw, 560px);
      padding: 0.5rem 0 4.5rem;
    }

    .hero-shell {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.75rem;
      text-align: center;
    }

    .hero-visual {
      --avatar-size: clamp(116px, 20vh, 200px);
      order: -1;
      width: calc(var(--avatar-size) * 1.5);
      margin-bottom: 0.9rem;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-kicker {
      margin-bottom: 0.7rem;
      font-size: 0.85rem;
    }

    .hero-kicker::after {
      content: '';
      flex-shrink: 0;
      width: 2rem;
      height: 2px;
      border-radius: 2px;
      background: var(--color-accent);
    }

    .hero-name {
      margin-bottom: 0.9rem;
      font-size: clamp(2.6rem, 13vw, 4rem);
    }

    .hero-tagline {
      margin-bottom: 0.6rem;
      font-size: 1rem;
      line-height: 1.6;
    }

    .hero-signature {
      margin-bottom: 1rem;
      padding-left: 0;
      border-left: 0;
      font-size: 0.86rem;
    }

    .hero-meta {
      justify-content: center;
      margin-bottom: 1.4rem;
      font-size: 0.82rem;
    }

    .hero-actions {
      justify-content: center;
      gap: 0.7rem;
    }

    .hero-btn {
      height: 2.75rem;
      padding: 0 1.2rem;
      font-size: 0.9rem;
    }

    .hero-social {
      justify-content: center;
      width: 100%;
      margin: 0.1rem 0 0;
      padding-left: 0;
      border-left: 0;
    }

    .hero-sticker {
      top: 4%;
      right: -12%;
      padding: 0.3rem 0.65rem;
      font-size: 0.72rem;
    }

    .hero-stats {
      left: 50%;
      bottom: -2%;
      padding: 0.45rem 0.2rem;
      border-radius: 12px;
      transform: translateX(-50%) rotate(-3deg);
    }

    .hero-stat {
      padding: 0 0.6rem;
    }

    .hero-stat dd {
      font-size: 1.15rem;
    }

    .hero-stat dt {
      font-size: 0.64rem;
    }

    .orbit-dot {
      width: 10px;
      height: 10px;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 25%, transparent);
    }
  }

  @media (max-width: 900px) and (max-height: 720px) {
    .hero-signature,
    .hero-meta {
      display: none;
    }

    .hero-tagline {
      margin-bottom: 1.1rem;
    }

    .scroll-text {
      display: none;
    }
  }

  /* ===== CONTENT WRAPPER ===== */
.content-wrapper {
  padding: var(--section-padding);
  min-height: 100vh;
  position: relative;
  margin-top: 100vh;
  transition: margin-top var(--transition-base);
  background: radial-gradient(ellipse at 0 0, var(--color-play-soft), transparent 550px), var(--color-bg);
}

.content-wrapper.hero-collapsed {
  margin-top: 0;
}

  .sidebar-drawer-toggle {
    display: none;
  }

  .sidebar-drawer-toggle.visible {
    opacity: 1;
    pointer-events: auto;
  }

.sidebar-overlay {
  display: none;
}

  .content-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .content-grid {
      grid-template-columns: 300px 1fr;
    }
  }

  /* ===== SIDEBAR ===== */
  .sidebar {
    animation: sidebarSlideIn 0.8s ease-out;
  }

  @keyframes sidebarSlideIn {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .sidebar-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: sticky;
    top: 2rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-offset);
  }

@media (max-width: 899px) {
  .sidebar-drawer-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 84%, rgba(255, 255, 255, 0.35));
    color: var(--color-text);
    position: fixed;
    left: 0.9rem;
    top: calc(env(safe-area-inset-top, 0px) + 0.9rem);
    transform: translateY(-8px) scale(0.96);
    cursor: pointer;
    z-index: 246;
    box-shadow:
      0 14px 28px rgba(15, 23, 42, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    transition:
      transform var(--transition-base),
      opacity var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
    opacity: 0;
    pointer-events: none;
  }

  .sidebar-drawer-toggle .icon-menu,
  .sidebar-drawer-toggle .icon-close {
    position: absolute;
    transition:
      transform 220ms ease,
      opacity 180ms ease;
  }

  .sidebar-drawer-toggle .icon-close {
    opacity: 0;
    transform: scale(0.7) rotate(-90deg);
  }

  .sidebar-drawer-toggle:hover {
    color: var(--color-secondary);
    box-shadow: var(--shadow-lg);
  }

  .sidebar-drawer-toggle.open {
    transform: translateY(0) scale(1);
    background: var(--color-secondary);
    color: var(--color-bg);
    border-color: transparent;
    box-shadow:
      0 18px 36px rgba(15, 23, 42, 0.18),
      0 0 0 6px color-mix(in srgb, var(--color-secondary) 16%, transparent);
  }

  .sidebar-drawer-toggle.open,
  .sidebar-drawer-toggle.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-drawer-toggle.visible {
    transform: translateY(0) scale(1);
  }

  .sidebar-drawer-toggle.open .icon-menu {
    opacity: 0;
    transform: scale(0.7) rotate(90deg);
  }

  .sidebar-drawer-toggle.open .icon-close {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .sidebar-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
    z-index: 235;
  }

  .sidebar-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-drawer {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: min(84vw, 340px);
    padding: calc(env(safe-area-inset-top, 0px) + 4.2rem) 0.75rem 1rem 1rem;
    transform: translateX(calc(-100% - 24px)) scale(0.98);
    transform-origin: left center;
    opacity: 0;
    visibility: hidden;
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease,
      visibility 220ms ease;
    z-index: 240;
    overflow: auto;
    animation: none;
  }

  .sidebar-drawer.open {
    transform: translateX(0) scale(1);
    opacity: 1;
    visibility: visible;
  }

  .sidebar-drawer .sidebar-card {
    position: static;
    min-height: 100%;
    border-radius: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 92%, rgba(255, 255, 255, 0.2)) 0%, color-mix(in srgb, var(--color-surface) 100%, transparent) 100%);
    box-shadow:
      0 26px 56px rgba(15, 23, 42, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.24);
    overflow: hidden;
  }

  .sidebar-card {
    position: static;
  }

  .sidebar {
    animation: none;
  }

  :global(body.sidebar-drawer-open) #ui-float-right {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateX(16px) !important;
  }
}

  .sidebar-header {
    padding: 2rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(155deg, var(--color-play-soft), var(--color-accent-soft));
  }

  .sidebar-avatar {
    width: 80px;
    height: 80px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-primary);
  }

  .sidebar-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-headline);
    margin-bottom: 0.5rem;
  }

  .sidebar-bio {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .sidebar-section {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-section:last-child {
    border-bottom: none;
  }

  .sidebar-section-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--color-bg-alt);
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 700;
    transition: all var(--transition-base);
  }

  .social-link:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
    transform: translateY(-2px);
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .activity-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .activity-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    margin-top: 0.375rem;
    flex-shrink: 0;
  }

  .activity-content {
    flex: 1;
  }

  .activity-text {
    font-size: 0.8rem;
    color: var(--color-text);
    margin-bottom: 0.125rem;
    line-height: 1.4;
  }

  .activity-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .activity-link:hover {
    color: var(--color-secondary);
  }

  .activity-time {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .tools-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .tool-item:hover {
    background: var(--color-tag-bg);
    transform: translateX(4px);
  }

  .tool-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .tool-desc {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .quote {
    border-left: 3px solid var(--color-accent);
