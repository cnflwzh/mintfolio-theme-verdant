    margin: 0;
  }

  .quote-text {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .quote-author {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: normal;
  }

  /* ===== BLOG SECTION ===== */
  .blog-section {
    min-height: 50vh;
  }

  .blog-header {
    margin-bottom: 2rem;
  }

  .blog-title-row {
    display: flex;
    justify-content: space-between;
