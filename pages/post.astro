  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
}

.lightbox-controls,
.lightbox-close {
  -webkit-user-select: none;
  user-select: none;
}

.lightbox-controls button {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: var(--radius-full);
  background: transparent;
  color: inherit;
