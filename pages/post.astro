---
/** Verdant article layout receives rendered body or an opaque encrypted payload. */
import ArticleLinks from '@mintfolio/core/components/ArticleLinks.astro';
import Base from '../layouts/Base.astro';
import { resolveThemeUrl } from '../utils/themeUrls';
import { formatSiteDate } from '../utils/dates';
import ArticleProse from '../components/blog/ArticleProse.astro';
import CodeBlockEnhancer from '../components/blog/CodeBlockEnhancer.astro';
import ProtectedArticle from '../components/blog/ProtectedArticle.astro';
import Image from '@mintfolio/core/components/Image.astro';
import type { PageProps, PostPageData } from '@mintfolio/theme-api/astro';
import type { VerdantSettings } from '../settings';

interface Props extends PageProps<VerdantSettings, PostPageData> {}
const { theme, page } = Astro.props;
const { post, body } = page;
const tocHeadings = body.kind === 'public' ? body.headings.filter((heading) => heading.depth === 2 || heading.depth === 3) : [];
const profileAvatar = theme.site.profile.avatar;
const footerImage = resolveThemeUrl(theme.settings.article.footerImage.src) || theme.site.profile.avatar;
const formatDate = (value: string) => formatSiteDate(value, theme.site.language, theme.site.blog?.timezone);
// Named authors replace the site owner in the byline instead of being listed twice.
const bylineAuthors = post.authors?.length ? post.authors : [{ id: 'profile', name: theme.site.profile.name, url: undefined }];
const isUpdated = Boolean(post.updatedAt && post.updatedAt !== post.publishedAt);

---

<Base theme={theme} page={page}>
  <article class="blog-post" id="content">
    <div class="container">
      <nav class="breadcrumb" aria-label="文章导航">
        <button type="button" class="back-btn" id="back-btn" aria-label="返回上一页" title="返回上一页">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
      </nav>

      <header class:list={['post-header', { 'no-cover': !post.cover }]}>
        {post.cover && (
          <div class="post-hero-cover glass-card">
            <Image src={post.cover} alt={post.title} loading="lazy" width={800} height={450} />
            <div class="post-hero-cover-mask" aria-hidden="true"></div>
          </div>
        )}

        <div class="post-heading">
          <div class="post-eyebrow">
            <a href={post.category.url} class="post-category">{post.category.label}</a>
            {post.pinned && <span class="post-flag">置顶</span>}
            {post.protected && <span class="post-flag">加密</span>}
            {post.preview && <strong class="post-flag is-preview">本地预览 · 尚未发布</strong>}
          </div>
          <h1 class="post-title" transition:name={`post-title-${post.id}`}>{post.title}</h1>
          {post.description && <p class="post-lead">{post.description}</p>}
        </div>

        {/* One ruled strip holds every fact about the article: who wrote it, then labelled figures. */}
        <div class="post-info">
          <div class="post-byline">
            <Image class="byline-avatar" src={profileAvatar} alt="" loading="lazy" width={44} height={44} />
            <div class="byline-text">
              <span class="info-label">作者</span>
              <p class="byline-name">
                {bylineAuthors.map((author, index) => (
                  <>
                    {index > 0 && <span class="byline-sep" aria-hidden="true">、</span>}
                    {author.url ? <a href={author.url} rel="author">{author.name}</a> : <span>{author.name}</span>}
                  </>
                ))}
              </p>
            </div>
          </div>
          <dl class="post-stats">
            <div class="post-stat">
              <dt class="info-label">发布</dt>
              <dd><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></dd>
            </div>
            {isUpdated && (
              <div class="post-stat">
                <dt class="info-label">更新</dt>
                <dd><time datetime={post.updatedAt}>{formatDate(post.updatedAt!)}</time></dd>
              </div>
            )}
            {post.readingMinutes !== undefined && (
              <div class="post-stat">
                <dt class="info-label">阅读</dt>
                <dd>约 {post.readingMinutes} 分钟</dd>
              </div>
            )}
            {post.wordCount !== undefined && (
              <div class="post-stat">
                <dt class="info-label">字数</dt>
                <dd>{new Intl.NumberFormat(theme.site.language).format(post.wordCount)} 字</dd>
              </div>
            )}
          </dl>
        </div>
      </header>

      {body.kind === 'protected' ? (
        <ProtectedArticle body={body}>
          {/* Empty theme markup only: neither headings nor article text are emitted while locked. */}
          <template slot="toc-template" data-toc-template>
          <!-- TOC 按钮（会被 JS 移动到 ui-float-right 容器中） -->
          <button class="toc-toggle" id="toc-toggle" aria-label="目录" aria-expanded="false" aria-controls="toc-card" title="目录" style="display: none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" aria-hidden="true">
              <path d="M4 6h16M4 12h12M4 18h8"/>
            </svg>
          </button>

          <!-- 遮罩层（仅平板/移动端） -->
          <div class="toc-overlay" id="toc-overlay" aria-hidden="true"></div>

          <!-- TOC 面板 -->
          <aside class="toc-card glass-card" id="toc-card">
            <div class="toc-header">
              <div class="toc-progress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
              <h2 class="toc-title">目录</h2>
            </div>
            <nav class="toc-nav" aria-label="文章目录">
              {[{ depth: 2, slug: '', text: '' }].map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`toc-link depth-${heading.depth}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
          </template>
        </ProtectedArticle>
      ) : (
        <>
          {tocHeadings.length > 0 && (
            <>
          <!-- TOC 按钮（会被 JS 移动到 ui-float-right 容器中） -->
          <button class="toc-toggle" id="toc-toggle" aria-label="目录" aria-expanded="false" aria-controls="toc-card" title="目录" style="display: none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" aria-hidden="true">
              <path d="M4 6h16M4 12h12M4 18h8"/>
            </svg>
          </button>

          <!-- 遮罩层（仅平板/移动端） -->
          <div class="toc-overlay" id="toc-overlay" aria-hidden="true"></div>

          <!-- TOC 面板 -->
          <aside class="toc-card glass-card" id="toc-card">
            <div class="toc-header">
              <div class="toc-progress" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
              <h2 class="toc-title">目录</h2>
            </div>
            <nav class="toc-nav" aria-label="文章目录">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`toc-link depth-${heading.depth}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
            </>
          )}
          <ArticleProse><Fragment set:html={body.html} /></ArticleProse>
        </>
      )}

      <CodeBlockEnhancer />

      {/* Tags close the article so the header keeps one focal point: the title. */}
      {post.tags && post.tags.length > 0 && (
        <nav class="post-tags" aria-label="文章标签">
          {post.tags.map(tag => (
            <a href={tag.url} class="tag">{tag.label}</a>
          ))}
        </nav>
      )}

      {theme.settings.article.footerImage.enabled && (
        <div class="post-footer-image glass-card">
          <Image src={footerImage} alt="文章结尾插图" loading="lazy" width={800} height={300} />
        </div>
      )}

      <aside class="post-author" aria-label="关于作者">
        <Image class="author-avatar" src={profileAvatar} alt={theme.site.profile.name} loading="lazy" width={64} height={64} />
        <div class="author-text">
          <p class="author-label">作者</p>
          <p class="author-name">{theme.site.profile.name}</p>
          {theme.site.profile.signature && <p class="author-signature">{theme.site.profile.signature}</p>}
        </div>
        <a href={theme.urls.page('about')} class="author-link">关于我 →</a>
      </aside>

      <ArticleLinks page={page} />



<!-- Image Lightbox Modal -->
<dialog class="image-lightbox" id="image-lightbox" aria-label="图片预览">
  <button class="lightbox-close" id="lightbox-close" type="button" aria-label="关闭图片预览">×</button>
  <div class="lightbox-viewport" id="lightbox-viewport">
    <img class="lightbox-image" id="lightbox-image" alt="图片预览" draggable="false" />
  </div>
  <div class="lightbox-controls" role="group" aria-label="图片缩放">
    <button id="lightbox-zoom-out" type="button" aria-label="缩小图片" title="缩小图片">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /></svg>
    </button>
    <output id="lightbox-zoom-level" aria-live="polite" aria-label="缩放比例">100%</output>
    <button id="lightbox-zoom-in" type="button" aria-label="放大图片" title="放大图片">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14" /></svg>
    </button>
    <button class="lightbox-reset" id="lightbox-reset" type="button" title="重置缩放">重置</button>
  </div>
</dialog>
</div>
</article>
</Base>

<style>
  /* Article Page Custom Scrollbar - Override global hide */
  html.blog-article-page,
  html.blog-article-page body {
    scrollbar-width: thin !important;
    scrollbar-color: var(--color-primary) var(--color-bg) !important;
    -ms-overflow-style: auto !important;
  }

  html.blog-article-page::-webkit-scrollbar,
  html.blog-article-page body::-webkit-scrollbar {
    width: 10px !important;
    height: 10px !important;
    display: block !important;
  }

  html.blog-article-page::-webkit-scrollbar-track,
  html.blog-article-page body::-webkit-scrollbar-track {
    background: var(--color-bg);
    border-radius: 5px;
  }

  html.blog-article-page::-webkit-scrollbar-thumb,
  html.blog-article-page body::-webkit-scrollbar-thumb {
    background: linear-gradient(
      180deg,
      var(--color-primary) 0%,
      color-mix(in srgb, var(--color-primary) 70%, var(--color-secondary)) 50%,
      var(--color-primary) 100%
    );
    border-radius: 5px;
    border: 2px solid var(--color-bg);
    background-clip: padding-box;
    transition: background 0.2s ease;
  }

  html.blog-article-page::-webkit-scrollbar-thumb:hover,
  html.blog-article-page body::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(
      180deg,
      var(--color-secondary) 0%,
      var(--color-primary) 50%,
      var(--color-secondary) 100%
    );
  }

  html.blog-article-page::-webkit-scrollbar-corner,
  html.blog-article-page body::-webkit-scrollbar-corner {
    background: var(--color-bg);
  }

  .blog-post {
    min-height: 100vh;
    padding: clamp(1.5rem, 4vw, 3.5rem) 1.5rem 5rem;
    background:
      radial-gradient(60% 420px at 85% 0%, color-mix(in srgb, var(--color-play-soft) 80%, transparent), transparent 70%),
      var(--color-bg);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  /* Pinned to the top-left corner of the viewport at every width. */
  .breadcrumb {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 200;
  }

  /* Where the side gutter is narrower than the button, start the header below it. */
  @media (min-width: 769px) and (max-width: 1000px) {
    .blog-post {
      padding-top: 5.25rem;
    }
  }

  .back-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base), color var(--transition-fast);
    cursor: pointer;
  }

  .back-btn:hover {
    color: var(--color-primary);
    transform: translateX(-2px);
    box-shadow: var(--shadow-lg);
  }

  .back-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-hero-cover {
    position: relative;
    width: 100%;
    margin: 0 0 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 2 / 1;
    border: 1px solid color-mix(in srgb, var(--color-border) 68%, transparent);
    box-shadow: var(--shadow-md);
  }

  .post-hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-hero-cover-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0) 40%);
    pointer-events: none;
  }

  /* ===== ARTICLE HEADER ===== */
  .post-heading {
    margin-bottom: 1.75rem;
  }

  .post-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  .post-category {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.8rem;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .post-category::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .post-category:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .post-flag {
    padding: 0.2rem 0.65rem;
    border: 1px dashed color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    border-radius: 999px;
    color: var(--color-primary);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .post-flag.is-preview {
    border-style: solid;
    border-color: transparent;
    background: var(--color-accent-soft);
    color: var(--color-text);
  }

  .post-title {
    margin-bottom: 1.1rem;
    font-size: clamp(1.85rem, 4.2vw, 2.65rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text-headline);
    text-wrap: balance;
    /* Break CJK titles at spaces and punctuation; split words only when a run cannot fit. */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  /* The lead reads as a set-off summary, not a second title: own rule, full measure, no balancing. */
  .post-lead {
    padding-left: 1rem;
    border-left: 3px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .post-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1rem 0;
    border-block: 1px solid var(--color-border);
  }

  .info-label {
    display: block;
    font: 0.66rem var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .post-byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .byline-avatar {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-surface);
    box-shadow: 0 0 0 1.5px var(--color-primary);
  }

  .byline-text {
    min-width: 0;
  }

  .byline-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.1rem;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.4;
    color: var(--color-text-headline);
  }

  .byline-name a {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .byline-name a:hover {
    color: var(--color-primary);
  }

  .byline-sep {
    color: var(--color-text-muted);
  }

  .post-stats {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .post-stat {
    padding: 0 1.15rem;
  }

  .post-stat + .post-stat {
    border-left: 1px solid var(--color-border);
  }

  .post-stat:last-child {
    padding-right: 0;
  }

  .post-stat dd {
    margin: 0.15rem 0 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .tag {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .tag::before {
    content: '#';
    margin-right: 0.15rem;
    color: var(--color-primary);
    opacity: 0.75;
  }

  .tag:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(115deg, var(--color-play-soft), var(--color-surface) 65%);
  }

  .author-avatar {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-surface);
    box-shadow: 0 0 0 1.5px var(--color-text);
  }

  .author-text {
    flex: 1;
    min-width: 0;
    line-height: 1.45;
  }

  .author-label {
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .author-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-headline);
  }

  .author-signature {
    margin-top: 0.1rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .author-link {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .author-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Series, related and adjacent links come from Core with neutral styles. */
  .blog-post :global(.mintfolio-article-links) {
    margin-top: 2.5rem;
    padding-top: 0;
    border-top: 0;
  }

  .blog-post :global(.mintfolio-article-links h2) {
    margin-bottom: 0.9rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-headline);
  }

  .blog-post :global(.mintfolio-series) {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .blog-post :global(.mintfolio-series h2 a) {
    text-decoration: none;
  }

  .blog-post :global(.mintfolio-series h2 a::before) {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.55rem;
    border-radius: 2px;
    background: var(--color-play);
    transform: rotate(45deg);
    vertical-align: 0.1em;
  }

  .blog-post :global(.mintfolio-series ol) {
    margin: 0;
    color: var(--color-text-muted);
  }

  .blog-post :global(.mintfolio-series a) {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .blog-post :global(.mintfolio-series a:hover),
  .blog-post :global(.mintfolio-series a[aria-current]) {
    color: var(--color-primary);
  }

  .blog-post :global(.mintfolio-related ul) {
    gap: 0.85rem;
  }

  .blog-post :global(.mintfolio-related li) {
    position: relative;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .blog-post :global(.mintfolio-related li:hover) {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .blog-post :global(.mintfolio-related a) {
    font-weight: 650;
    color: var(--color-text-headline);
    text-decoration: none;
  }

  /* Stretch the title link over the whole card. */
  .blog-post :global(.mintfolio-related a::after) {
    content: '';
    position: absolute;
    inset: 0;
  }

  .blog-post :global(.mintfolio-related p) {
    margin-top: 0.3rem;
    color: var(--color-text-muted);
    opacity: 1;
  }

  .blog-post :global(.mintfolio-adjacent) {
    gap: 0.85rem;
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: 0;
  }

  .blog-post :global(.mintfolio-adjacent a) {
    display: block;
    height: 100%;
    padding: 0.9rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
