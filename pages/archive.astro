---
/** Core builds each archive page; search independently queries the complete public index. */
import PostCard from '../components/blog/PostCard.astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import Pagination from '@mintfolio/core/components/Pagination.astro';
import Base from '../layouts/Base.astro';
import type { PageProps, ListPageData } from '@mintfolio/theme-api/astro';
import type { VerdantSettings } from '../settings';

interface Props extends PageProps<VerdantSettings, ListPageData> {}
const { theme, page } = Astro.props;
const posts = page.posts;
const total = page.pagination?.totalItems ?? posts.length;
const [allTags, allCategories] = await Promise.all([theme.taxonomy.tags(), theme.taxonomy.categories()]);
const isFiltered = Boolean(page.filters.category || page.filters.tag);
---
<Base theme={theme} page={page}>
  <main class="blog-page" id="content">
    <div class="container">
      <nav class="page-nav" aria-label="页面导航">
        <a href={theme.urls.home()} class="back-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          返回首页
        </a>
      </nav>
      <header class="page-header">
        <div>
          <p class="page-eyebrow">{isFiltered ? 'FILTERED NOTES' : 'NOTES & IDEAS'}</p>
          <h1 class="page-title">{page.title}<span aria-hidden="true">.</span></h1>
          {page.description && <p class="page-subtitle">{page.description}</p>}
        </div>
        <div class="archive-count">
          <strong>{total}</strong>
          <span>{isFiltered ? '篇相关文章' : '篇文章，持续积累中'}</span>
        </div>
      </header>
      <section class="filter-panel" aria-label="搜索和筛选">
        <div class="search-panel">
          <SearchPanel />
        </div>
        <nav class="controls" aria-label="文章分类和标签">
          <div class="taxonomy-row">
            <span class="taxonomy-label">浏览</span>
            <div class="category-filter">
              <a class:list={['category-btn', { active: !isFiltered }]}
                href={theme.urls.archive()} aria-current={!isFiltered ? 'page' : undefined}>全部文章</a>
              {allCategories.map((category) => <a class:list={['category-btn', { active: page.filters.category === category.label }]}
                href={category.url} aria-current={page.filters.category === category.label ? 'page' : undefined}>{category.label}<span class="count">{category.count}</span></a>)}
            </div>
          </div>
          {allTags.length > 0 && <div class="taxonomy-row">
            <span class="taxonomy-label">标签</span>
            <div class="tags-filter">
              {allTags.map((tag) => <a class:list={['tag-btn', { active: page.filters.tag === tag.label }]}
                href={tag.url} aria-current={page.filters.tag === tag.label ? 'page' : undefined}>#{tag.label}<span class="count">{tag.count}</span></a>)}
            </div>
          </div>}
        </nav>
      </section>
      {posts.length > 0 ? <div class="posts-list">
        {posts.map((post, index) => <PostCard post={post} index={index} pageSize={posts.length} variant="blog" language={theme.site.language} timezone={theme.site.blog?.timezone} />)}
      </div> : <p class="no-results">这里还没有文章。</p>}
      {page.pagination && <Pagination pagination={page.pagination} />}
    </div>
  </main>
</Base>
<style>
  .blog-page {
    min-height: 100vh; padding: clamp(1.5rem, 4vw, 2.5rem) 1.5rem 5rem;
    background:
      radial-gradient(55% 480px at 95% 0%, color-mix(in srgb, var(--color-play-soft) 85%, transparent), transparent 70%),
      var(--color-bg);
    --mintfolio-search-color: var(--color-text);
    --mintfolio-search-border: var(--color-border);
    --mintfolio-search-background: var(--color-bg);
    --mintfolio-search-result-background: var(--color-bg-alt);
    --mintfolio-search-accent: var(--color-primary);
    --mintfolio-search-highlight: var(--color-play);
    --mintfolio-search-highlight-color: var(--color-text);
    --mintfolio-search-radius: 999px;
    --mintfolio-pagination-color: var(--color-text);
    --mintfolio-pagination-border: var(--color-border);
    --mintfolio-pagination-background: var(--color-surface);
    --mintfolio-pagination-active-background: var(--color-primary);
    --mintfolio-pagination-active-color: var(--color-on-primary);
    --mintfolio-pagination-focus: var(--color-primary);
    --mintfolio-pagination-radius: 999px;
  }
  .container { max-width: 960px; margin: 0 auto; }
  .page-nav { margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .back-btn { display: inline-flex; align-items: center; gap: .45rem; color: var(--color-text-muted); text-decoration: none; font-size: .875rem; transition: color var(--transition-fast), border-color var(--transition-fast); padding: .5rem 1rem; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-surface); }
  .back-btn svg { width: 1rem; height: 1rem; transition: transform var(--transition-fast); }
  .back-btn:hover { color: var(--color-primary); border-color: var(--color-primary); }
  .back-btn:hover svg { transform: translateX(-2px); }
  .page-header { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .page-eyebrow { font: .7rem var(--font-mono); letter-spacing: .16em; color: var(--color-primary); margin-bottom: .5rem; }
  .page-title { font-size: clamp(2.1rem, 5vw, 3.1rem); font-weight: 800; line-height: 1.15; color: var(--color-text-headline); letter-spacing: -.03em; text-wrap: balance; }
  .page-title > span { color: var(--color-primary); }
  .page-subtitle { margin-top: .75rem; font-size: 1.05rem; line-height: 1.7; color: var(--color-text-muted); }
  .archive-count { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: .15rem; padding: .85rem 1.4rem; border: 1.5px solid var(--color-text); border-radius: 16px; background: var(--color-surface); box-shadow: 4px 4px 0 var(--color-accent-soft); transform: rotate(3deg); }
  .archive-count strong { font: 700 2.6rem/1 var(--font-display); color: var(--color-primary); }
  .archive-count span { font-size: .72rem; color: var(--color-text-muted); white-space: nowrap; }
  .filter-panel { margin-bottom: 2rem; padding: 1.35rem 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .search-panel { padding-bottom: 1.25rem; margin-bottom: 1.15rem; border-bottom: 1px dashed var(--color-border); }
  .search-panel :global(.mintfolio-search__form label) { font-size: .82rem; color: var(--color-text-muted); font-weight: 600; }
  .search-panel :global(.mintfolio-search input) { padding-inline: 1.1rem; }
  .search-panel :global(.mintfolio-search button[type='submit']) { padding-inline: 1.3rem; background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); font-weight: 600; }
  .search-panel :global(.mintfolio-search__results .mintfolio-search__result) { border-radius: var(--radius-md); }
  .controls { display: flex; flex-direction: column; gap: .85rem; }
  .taxonomy-row { display: flex; align-items: baseline; gap: .9rem; width: 100%; }
  .taxonomy-label { flex-shrink: 0; width: 2.2em; font-size: .82rem; font-weight: 600; color: var(--color-text-muted); }
  .category-filter, .tags-filter { display: flex; flex-wrap: wrap; gap: .45rem; }
  .category-btn, .tag-btn { display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .85rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg); color: var(--color-text); font-size: .82rem; font-weight: 500; text-decoration: none; transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast); }
  .count { font: .7rem var(--font-mono); color: var(--color-text-muted); }
  .category-btn:hover, .tag-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .category-btn.active, .tag-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); }
  .category-btn.active .count, .tag-btn.active .count { color: inherit; opacity: .75; }
  .posts-list { display: flex; flex-direction: column; gap: 1rem; }
  .no-results { text-align: center; color: var(--color-text-muted); padding: 3rem; border: 1px dashed var(--color-border); border-radius: var(--radius-lg); }
  @media (max-width: 600px) {
    .blog-page { padding-inline: 1rem; }
    .page-header { gap: 1rem; }
    .page-subtitle { font-size: .9rem; }
    .archive-count { padding: .6rem .8rem; }
    .archive-count strong { font-size: 1.9rem; }
    .archive-count span { max-width: 5.5em; white-space: normal; text-align: center; font-size: .62rem; }
    .filter-panel { padding: 1.1rem; }
    .taxonomy-row { flex-direction: column; gap: .45rem; }
  }
</style>
