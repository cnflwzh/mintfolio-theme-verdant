---
/** Core builds each archive page; search independently queries the complete public index. */
import PostCard from '../components/blog/PostCard.astro';
import SearchPanel from '@mintfolio/core/components/SearchPanel.astro';
import Pagination from '@mintfolio/core/components/Pagination.astro';
import Base from '../layouts/Base.astro';
import type { PageProps, ListPageData } from '@mintfolio/theme-api/astro';
import type { VerdantSettings } from '../settings';

interface Props extends PageProps<VerdantSettings, ListPageData> {}
const { theme, page } = Astro.props;
const posts = page.posts;
const total = page.pagination?.totalItems ?? posts.length;
const [allTags, allCategories] = await Promise.all([theme.taxonomy.tags(), theme.taxonomy.categories()]);
---
<Base theme={theme} page={page}>
  <main class="blog-page" id="content">
    <div class="container">
      <nav class="page-nav" aria-label="页面导航">
        <a href={theme.urls.home()} class="back-btn">← 返回首页</a>
      </nav>
      <header class="page-header">
        <div>
          <p class="page-eyebrow">NOTES & IDEAS</p>
          <h1 class="page-title">{page.title}<span aria-hidden="true">.</span></h1>
          <p class="page-subtitle">{page.description}</p>
        </div>
        <div class="archive-count"><span aria-hidden="true">✳</span><strong>{total}</strong><span>篇文章，持续积累中</span></div>
      </header>
      <div class="search-panel">
        <SearchPanel />
      </div>
      <nav class="controls" aria-label="文章分类和标签">
        <a class:list={['category-btn', { active: !page.filters.category && !page.filters.tag }]}
          href={theme.urls.archive()} aria-current={!page.filters.category && !page.filters.tag ? 'page' : undefined}>全部文章</a>
        {allCategories.length > 0 && <div class="taxonomy-row">
          <span class="taxonomy-label">分类</span>
          <div class="category-filter">
            {allCategories.map((category) => <a class:list={['category-btn', { active: page.filters.category === category.label }]}
              href={category.url} aria-current={page.filters.category === category.label ? 'page' : undefined}>{category.label} ({category.count})</a>)}
          </div>
        </div>}
        {allTags.length > 0 && <div class="taxonomy-row">
          <span class="taxonomy-label">标签</span>
          <div class="tags-filter">
            {allTags.map((tag) => <a class:list={['tag-btn', { active: page.filters.tag === tag.label }]}
              href={tag.url} aria-current={page.filters.tag === tag.label ? 'page' : undefined}>#{tag.label} ({tag.count})</a>)}
          </div>
        </div>}
      </nav>
      {posts.length > 0 ? <div class="posts-list">
        {posts.map((post, index) => <PostCard post={post} index={index} pageSize={posts.length} variant="blog" language={theme.site.language} timezone={theme.site.blog?.timezone} />)}
      </div> : <p class="no-results">这里还没有文章。</p>}
      {page.pagination && <Pagination pagination={page.pagination} />}
    </div>
  </main>
</Base>
<style>
  .blog-page {
    min-height: 100vh; padding: 2rem 1.5rem 5rem;
    background: radial-gradient(ellipse at 100% 0, var(--color-play-soft), transparent 600px), var(--color-bg);
    --mintfolio-search-color: var(--color-text);
    --mintfolio-search-border: var(--color-border);
    --mintfolio-search-background: var(--color-surface);
    --mintfolio-search-result-background: var(--color-bg-alt);
    --mintfolio-search-accent: var(--color-secondary);
    --mintfolio-search-highlight: var(--color-primary);
    --mintfolio-search-highlight-color: var(--color-on-primary);
    --mintfolio-search-radius: var(--radius-md);
    --mintfolio-pagination-color: var(--color-text);
    --mintfolio-pagination-border: var(--color-border);
    --mintfolio-pagination-background: var(--color-surface);
    --mintfolio-pagination-active-background: var(--color-primary);
    --mintfolio-pagination-active-color: var(--color-on-primary);
    --mintfolio-pagination-radius: var(--radius-md);
  }
  .container { max-width: var(--max-width); margin: 0 auto; }
  .page-nav { margin-bottom: 2rem; }
  .back-btn { display: inline-flex; align-items: center; gap: .5rem; color: var(--color-text-muted); text-decoration: none; font-size: .875rem; transition: color var(--transition-fast), border-color var(--transition-fast); padding: .5rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface); }
  .back-btn:hover { color: var(--color-secondary); border-color: var(--color-secondary); }
  .page-header { margin-bottom: 2rem; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 2rem 2.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-offset); }
  .page-eyebrow { font: .7rem var(--font-mono); letter-spacing: .16em; color: var(--color-primary); margin-bottom: .65rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: var(--color-text-headline); margin-bottom: .5rem; font-family: var(--font-family); letter-spacing: -.04em; }
  .page-title > span { color: var(--color-primary); }
  .page-subtitle { font-size: 1rem; color: var(--color-text-muted); }
  .archive-count { flex-shrink: 0; text-align: center; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .2rem .8rem; transform: rotate(4deg); background: var(--color-play-soft); border: 1px solid var(--color-border); border-radius: 16px; padding: .8rem 1.3rem; }
  .archive-count > span:first-child { color: var(--color-primary); font-size: 2.5rem; }
  .archive-count strong { font: 700 2.75rem var(--font-display); }
  .archive-count > span:last-child { grid-column: 1 / -1; font-size: .68rem; color: var(--color-text-muted); }
  .search-panel, .controls { margin-bottom: 1.25rem; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .controls { display: flex; flex-direction: column; align-items: flex-start; gap: .85rem; margin-bottom: 2rem; }
  .taxonomy-row { display: flex; align-items: baseline; gap: .75rem; width: 100%; }
  .taxonomy-label { flex-shrink: 0; font-size: .8rem; color: var(--color-text-muted); }
  .category-filter, .tags-filter { display: flex; flex-wrap: wrap; gap: .5rem; }
  .category-btn, .tag-btn { display: inline-block; padding: .375rem .875rem; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: var(--color-bg-alt); color: var(--color-text-muted); font-size: .8rem; font-weight: 500; text-decoration: none; transition: color var(--transition-fast), border-color var(--transition-fast); }
  .category-btn:hover, .tag-btn:hover { border-color: var(--color-secondary); color: var(--color-text); }
  .category-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); }
  .tag-btn.active { background: var(--color-secondary); color: var(--color-bg); border-color: var(--color-secondary); }
  .posts-list { display: flex; flex-direction: column; gap: 1rem; }
  .no-results { text-align: center; color: var(--color-text-muted); padding: 3rem; }
  @media (max-width: 600px) {
    .page-header { gap: .75rem; padding: 1.25rem; }
    .page-subtitle { font-size: .8rem; }
    .archive-count { padding: .6rem; grid-template-columns: 1fr; gap: 0; }
    .archive-count > span:first-child { display: none; }
    .archive-count strong { font-size: 2rem; }
    .archive-count > span:last-child { max-width: 6em; font-size: .6rem; }
    .page-title { font-size: 1.8rem; }
    .search-panel, .controls { padding: 1rem; }
  }
</style>