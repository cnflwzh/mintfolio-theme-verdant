---
/** Render Core-provided page content; the built-in about page retains the profile layout. */
import Base from '../layouts/Base.astro';
import ArticleProse from '../components/blog/ArticleProse.astro';
import CodeBlockEnhancer from '../components/blog/CodeBlockEnhancer.astro';
import SocialIcon from '../components/base/SocialIcon.astro';
import { formatSiteDate } from '../utils/dates';
import { resolveThemeUrl } from '../utils/themeUrls';
import type { PageProps, StaticPageData } from '@mintfolio/theme-api/astro';
import type { VerdantSettings } from '../settings';

interface Props extends PageProps<VerdantSettings, StaticPageData> {}
import Image from '@mintfolio/core/components/Image.astro';

const { theme, page } = Astro.props;
const { profile } = theme.site;
const profileAvatar = profile.avatar;
// Core page titles may carry the site name for the document title; the visible heading drops it.
const siteSuffix = ` - ${theme.site.title}`;
const heading = page.title.endsWith(siteSuffix) ? page.title.slice(0, -siteSuffix.length) : page.title;
// Empty groups do not count as skills and should not leave an empty section.
const skillGroups = theme.site.skills.filter((group) => group.items.length > 0);
const projects = theme.site.projects;
const contactEmail = theme.site.contact.email;
---

<Base theme={theme} page={page}>
  <main class="about-page" id="content">
    <div class="container">
      <nav class="page-nav" aria-label="页面导航">
        <a href={theme.urls.home()} class="back-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          返回首页
        </a>
      </nav>

      {page.body ? (
        <>
          <header class="page-header">
            <h1 class="page-title">{heading}<span class="title-dot" aria-hidden="true">.</span></h1>
            {page.description && <p class="page-subtitle">{page.description}</p>}
            {page.updatedAt && (
              <p class="page-updated">更新于 <time datetime={page.updatedAt}>{formatSiteDate(page.updatedAt, theme.site.language, theme.site.blog?.timezone)}</time></p>
            )}
          </header>
          <ArticleProse><Fragment set:html={page.body.html} /></ArticleProse>
          <CodeBlockEnhancer />
        </>
      ) : page.id === 'about' && (
        <>
          <header class="profile">
            <div class="profile-visual" aria-hidden="true">
              <span class="profile-blob"></span>
              <Image src={profileAvatar} alt="" class="profile-avatar" width={160} height={160} />
            </div>
            <div class="profile-body">
              <p class="page-eyebrow">ABOUT ME</p>
              <h1 class="page-title">{heading}<span class="title-dot" aria-hidden="true">.</span></h1>
              <p class="profile-name">
                <span>{profile.name}</span>
                {profile.location && (
                  <span class="profile-location">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    {profile.location}
                  </span>
                )}
              </p>
              {profile.bio && <p class="profile-bio">{profile.bio}</p>}
              {profile.signature && <p class="profile-signature">{profile.signature}</p>}

              {(contactEmail || theme.site.social.length > 0) && (
                <div class="profile-links">
                  {contactEmail && (
                    <a class="profile-email" href={`mailto:${contactEmail}`}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2.5"/>
                        <path d="m3.5 7 8.5 6 8.5-6"/>
                      </svg>
                      {contactEmail}
                    </a>
                  )}
                  {theme.site.social.length > 0 && (
                    <nav class="profile-social" aria-label="社交链接">
                      {theme.site.social.map((item) => (
                        <a class="profile-social-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.platform} title={item.platform}>
                          <SocialIcon icon={item.icon} platform={item.platform} />
                        </a>
                      ))}
                    </nav>
                  )}
                </div>
              )}
            </div>
          </header>

          {skillGroups.length > 0 && (
            <section class="about-section" aria-labelledby="skills-heading">
              <div class="section-head">
                <p class="page-eyebrow">SKILLS</p>
                <h2 class="section-title" id="skills-heading">技能栈<span class="title-dot" aria-hidden="true">.</span></h2>
              </div>
              <div class="skill-groups">
                {skillGroups.map((group) => (
                  <article class="skill-group">
                    <h3>{group.category}</h3>
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          <div class="skill-row">
                            <span>{item.name}</span>
                            <span class="level">{item.level}%</span>
                          </div>
                          <span class="skill-bar" aria-hidden="true"><span style={`width: ${Math.min(Math.max(item.level, 0), 100)}%`}></span></span>
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </section>
          )}

          {projects.length > 0 && (
            <section class="about-section" aria-labelledby="projects-heading">
              <div class="section-head">
                <p class="page-eyebrow">PROJECTS</p>
                <h2 class="section-title" id="projects-heading">项目<span class="title-dot" aria-hidden="true">.</span></h2>
              </div>
              <div class="project-list">
                {projects.map((project, index) => (
                  <article class="project-item" aria-labelledby={`project-${index}`}>
                    {project.image && (
                      <div class="project-image">
                        <img src={resolveThemeUrl(project.image)} alt="" loading="lazy" decoding="async" />
                      </div>
                    )}
                    <div class="project-body">
                      <h3 id={`project-${index}`}>{project.title}</h3>
                      <p>{project.description}</p>
                      {project.tags.length > 0 && (
                        <div class="tags">
                          {project.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                          ))}
                        </div>
                      )}
                      {(project.link || project.repo) && (
                        <div class="links">
                          {project.link && (
                            <a href={project.link} target="_blank" rel="noopener noreferrer" aria-label={`${project.title}在线预览`}>
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>
                              </svg>
                              在线预览
                            </a>
                          )}
                          {project.repo && (
                            <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`${project.title}源码`}>
                              <SocialIcon icon="github" platform="github" size={15} />
                              源码
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}
        </>
      )}

      <footer class="footer">
        <p>© {formatSiteDate(new Date(), theme.site.language, theme.site.blog?.timezone, { year: 'numeric' })} {profile.name}</p>
        <p class="site-links">
          <a href={theme.urls.rss()} target="_blank" rel="noopener noreferrer">RSS 订阅</a>
          <span aria-hidden="true">·</span>
          <a href={theme.urls.sitemap()} target="_blank" rel="noopener noreferrer">网站树</a>
        </p>
        {theme.site.icp && (
          <p class="icp">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{theme.site.icp}</a>
          </p>
        )}
      </footer>
    </div>
  </main>
</Base>

<style>
  .about-page {
    min-height: 100vh;
    padding: clamp(1.5rem, 4vw, 2.5rem) 1.5rem 3rem;
    background:
      radial-gradient(55% 480px at 90% 0%, color-mix(in srgb, var(--color-play-soft) 85%, transparent), transparent 70%),
      radial-gradient(35% 320px at 0% 35%, color-mix(in srgb, var(--color-accent-soft) 35%, transparent), transparent 70%),
      var(--color-bg);
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
  }

  .page-nav {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .back-btn svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--transition-fast);
  }

  .back-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .back-btn:hover svg {
    transform: translateX(-2px);
  }

  .page-eyebrow {
    margin-bottom: 0.5rem;
    color: var(--color-primary);
    font: 0.7rem var(--font-mono);
    letter-spacing: 0.16em;
  }

  .page-title {
    font-size: clamp(2.1rem, 5vw, 3.1rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-headline);
    text-wrap: balance;
  }

  .title-dot {
    color: var(--color-primary);
  }

  /* Generic Markdown page */
  .page-header {
    margin-bottom: 2rem;
  }

  .page-subtitle {
    margin-top: 0.75rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .page-updated {
    margin-top: 0.5rem;
    font-size: 0.83rem;
    color: var(--color-text-muted);
  }

  /* Profile header */
  .profile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .profile-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: 200px;
    aspect-ratio: 1;
  }

  .profile-blob {
    position: absolute;
    inset: 4%;
    background: var(--color-play);
    border-radius: 58% 42% 55% 45% / 46% 56% 44% 54%;
    transform: translate(8%, 6%) rotate(-8deg);
  }

  :global([data-theme^='dark']) .profile-blob {
    opacity: 0.4;
  }

  .profile-avatar {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid var(--color-surface);
    box-shadow:
      0 0 0 1.5px var(--color-text),
      0 20px 40px -20px color-mix(in srgb, var(--color-text) 45%, transparent);
  }

  .profile-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 650;
    color: var(--color-text);
  }

  .profile-location {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .profile-location svg {
    width: 1rem;
    height: 1rem;
    color: var(--color-primary);
  }

  .profile-bio {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .profile-signature {
    max-width: 36rem;
    margin-top: 0.6rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-accent);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
  }

  .profile-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.15rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--color-primary) 80%, transparent);
    transition: transform var(--transition-fast);
  }

  .profile-email svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .profile-email:hover {
    transform: translateY(-2px);
  }

  .profile-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .profile-social-link {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-weight: 700;
    transition: color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .profile-social-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  /* Sections */
  .about-section {
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .section-head {
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-headline);
  }

  .skill-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  .skill-group {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .skill-group h3 {
    margin-bottom: 0.9rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-headline);
  }

  .skill-group ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.3rem;
    font-size: 0.88rem;
    color: var(--color-text);
  }

  .level {
    color: var(--color-text-muted);
    font: 0.78rem var(--font-mono);
  }

  .skill-bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .skill-bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
  }

  .skill-group:nth-child(3n + 2) .skill-bar > span {
    background: var(--color-accent);
  }

  .skill-group:nth-child(3n + 3) .skill-bar > span {
    background: color-mix(in srgb, var(--color-play) 70%, var(--color-text));
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  .project-item {
    --card-color: var(--color-primary);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .project-item:nth-child(3n + 2) { --card-color: var(--color-accent); }
  .project-item:nth-child(3n + 3) { --card-color: var(--color-play); }

  .project-item:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border));
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--card-color) 24%, var(--color-bg));
  }

  .project-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-item:hover .project-image img {
    transform: scale(1.04);
  }

  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.35rem 1.2rem;
  }

  /* Without an image, a colored top rule gives each card the same rhythm. */
  .project-item:not(:has(.project-image))::before {
    content: '';
    height: 4px;
    background: var(--card-color);
  }

  .project-body h3 {
    margin-bottom: 0.45rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-headline);
  }

  .project-body p {
    margin-bottom: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin-bottom: 1rem;
  }

  .tag {
    padding: 0;
    background: none;
    border-radius: 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .tag::before {
    content: '#';
    margin-right: 0.12rem;
    color: var(--color-primary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .links svg {
    width: 15px;
    height: 15px;
  }

  .links a:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .site-links {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }

  .icp {
    margin-top: 0.35rem;
  }

  .footer a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 680px) {
    .about-page {
      padding-inline: 1rem;
    }

    .profile {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .profile-visual {
      width: 150px;
    }

    .profile-avatar {
      width: 120px;
      height: 120px;
    }

    .profile-name,
    .profile-links {
      justify-content: center;
    }

    .profile-signature {
      padding-left: 0;
      border-left: 0;
    }

    .profile-bio,
    .profile-signature {
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-item,
    .project-image img {
      transition: none;
    }

    .project-item:hover,
    .project-item:hover .project-image img {
      transform: none;
    }
  }
</style>
